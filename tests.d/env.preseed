# Shared defaults for Smokey – available before every test.
# PROJECT_ROOT: workspace root (one level above tests.d)
export PROJECT_ROOT="$(cd "${SMOKEY_TEST_ROOT}/.." && pwd -P)"
# Convenience shortcuts used by the scripts
export DEANNON_PS1="${PROJECT_ROOT}/deannon.ps1"

# Placeholders for values that 000-setup/010-anonymize fill later
export WORK_DIR=""
export CONFIG_PATH=""
export INPUT_PATH=""
export ORIGINAL_PATH=""
export EXPECTED_ANON_PATH=""
export AUTO_FILE=""
export CONFIG_AFTER_ANON=""
export AUTO_AFTER_ANON=""

assert_file_matches() {
    if [[ $# -lt 2 || $# -gt 3 ]]; then
        echo "Usage: assert_file_matches <file> <regex> [expected_count]" >&2
        exit 1
    fi
    local target_file="$1"
    local regex="$2"
    local expected_count="${3-}"
    if [[ ! -f "$target_file" ]]; then
        echo "Assert failed: file '$target_file' not found" >&2
        exit 1
    fi

    local pipefail_on=0
    if set -o | grep -q 'pipefail[[:space:]]\+on'; then
        pipefail_on=1
    fi
    set +o pipefail
    local match_raw
    match_raw=$(rg --pcre2 -o "$regex" "$target_file" | wc -l | tr -d '[:space:]')
    local rg_status=${PIPESTATUS[0]:-0}
    local wc_status=${PIPESTATUS[1]:-0}
    local tr_status=${PIPESTATUS[2]:-0}
    if [[ $pipefail_on -eq 1 ]]; then
        set -o pipefail
    fi

    if [[ $wc_status -ne 0 || $tr_status -ne 0 ]]; then
        echo "Assert failed: counting matches for '$regex' in '$target_file' failed" >&2
        exit 1
    fi
    if [[ $rg_status -gt 1 ]]; then
        echo "Assert failed: rg error (status $rg_status) while scanning '$target_file'" >&2
        exit 1
    fi
    if [[ -z "$match_raw" ]]; then
        match_raw=0
    fi

    if [[ -z "$expected_count" ]]; then
        if [[ "$match_raw" -eq 0 ]]; then
            echo "Assert failed: pattern '$regex' not found in '$target_file'" >&2
            exit 1
        fi
        return
    fi

    if [[ ! "$expected_count" =~ ^[0-9]+$ ]]; then
        echo "Assert failed: expected count '$expected_count' is not a non-negative integer" >&2
        exit 1
    fi
    if [[ "$match_raw" -ne "$expected_count" ]]; then
        echo "Assert failed: pattern '$regex' expected $expected_count matches in '$target_file' but found $match_raw" >&2
        exit 1
    fi
}

assert_file_not_matches() {
    if [[ $# -ne 2 ]]; then
        echo "Usage: assert_file_not_matches <file> <regex>" >&2
        exit 1
    fi
    local target_file="$1"
    local regex="$2"
    if [[ ! -f "$target_file" ]]; then
        echo "Assert failed: file '$target_file' not found" >&2
        exit 1
    fi
    if rg --pcre2 -q "$regex" "$target_file"; then
        echo "Assert failed: unexpected pattern '$regex' present in '$target_file'" >&2
        exit 1
    fi
}
